# 환경변수 템플릿 파일
# 이 파일을 복사하여 .env로 이름을 변경하고 실제 값을 입력하세요

# OpenAI GPT-5 API 설정 (메인 AI)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Gemini API 설정 (Fallback)
GEMINI_API_KEY=YOUR_ACTUAL_API_KEY_HERE

# Brave Search API (이미 설정됨)
BRAVE_API_KEY=YOUR_BRAVE_API_KEY_HERE

# 사용법:
# 1. .env 파일을 생성하세요 (이 파일을 복사)
# 2. YOUR_OPENAI_API_KEY_HERE를 실제 OpenAI API 키로 교체하세요 (sk-proj-로 시작)
# 3. YOUR_ACTUAL_API_KEY_HERE를 실제 Gemini API 키로 교체하세요 (AIza로 시작)
# 4. .env 파일은 Git에 커밋하지 마세요 (.gitignore에 추가됨)

# API 키 발급:
# OpenAI GPT-5: https://platform.openai.com/api-keys
# Gemini: https://makersuite.google.com/app/apikey